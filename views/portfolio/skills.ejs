<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-ink">

  <%- include('../partials/nav') %>

  <section class="pt-40 pb-24 max-w-5xl mx-auto px-6 md:px-10">
    <p class="text-accent text-sm font-semibold tracking-wide">/ Skills</p>
    <h1 class="font-display font-extrabold text-5xl mt-4 mb-12">Technical Skills</h1>

    <div class="grid md:grid-cols-2 gap-6">
      <% Object.keys(profile.skills).forEach(function(category) { %>
        <div class="bg-panel border border-white/10 rounded-xl p-6">
          <h3 class="font-display font-semibold text-lg mb-4"><%= category %></h3>
          <div class="flex flex-wrap gap-2">
            <% profile.skills[category].forEach(function(skill) { %>
              <span class="px-3 py-1.5 rounded-full bg-ink/60 border border-white/10 text-xs text-white/70"><%= skill %></span>
            <% }) %>
          </div>
        </div>
      <% }) %>
    </div>
  </section>

  <%- include('../partials/footer') %>

</body>
</html>

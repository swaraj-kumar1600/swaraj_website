<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-ink">

  <%- include('../partials/nav') %>

  <section class="pt-40 pb-24 max-w-2xl mx-auto px-6 md:px-10">
    <p class="text-accent text-sm font-semibold tracking-wide">/ Contact</p>
    <h1 class="font-display font-extrabold text-5xl mt-4 mb-4">Let's work together</h1>
    <p class="text-white/60 mb-10">
      Send a message and I'll get back to you within a couple of days, or email me directly at
      <a href="mailto:sk.swaraj48raj@gmail.com" class="text-accent hover:underline">sk.swaraj48raj@gmail.com</a>.
    </p>

    <form method="POST" action="/contact" class="space-y-5">
      <div class="grid sm:grid-cols-2 gap-5">
        <input name="name" type="text" placeholder="Your name" required
          class="bg-panel border border-white/10 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-accent" />
        <input name="email" type="email" placeholder="Your email" required
          class="bg-panel border border-white/10 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-accent" />
      </div>
      <input name="subject" type="text" placeholder="Subject"
        class="w-full bg-panel border border-white/10 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-accent" />
      <textarea name="body" rows="5" placeholder="Message" required
        class="w-full bg-panel border border-white/10 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-accent"></textarea>
      <button type="submit"
        class="btn-gradient !px-6 !py-3 text-sm normal-case">>
        Send Message <i class="fa-solid fa-arrow-right text-[10px]"></i>
      </button>
    </form>
  </section>

  <%- include('../partials/footer') %>

</body>
</html>

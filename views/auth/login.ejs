<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-ink min-h-screen">
  <%- include('../partials/nav') %>

  <main class="min-h-screen pt-36 pb-20 px-6 flex items-center justify-center">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <span class="pill"><i class="fa-solid fa-lock text-accent"></i> Secure access</span>
        <h1 class="font-display font-extrabold text-4xl md:text-5xl mt-5">Welcome back</h1>
        <p class="text-white/50 mt-3">Sign in to view your semester results.</p>
      </div>

      <% if (created) { %>
        <div class="mb-5 px-4 py-3 rounded-xl bg-accent/10 border border-accent/30 text-accent text-sm">
          <i class="fa-solid fa-circle-check mr-2"></i>Account created. You can sign in now.
        </div>
      <% } %>

      <% if (error) { %>
        <div class="mb-5 px-4 py-3 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-sm">
          <i class="fa-solid fa-circle-exclamation mr-2"></i><%= error === 'login' ? 'Please sign in to continue.' : error %>
        </div>
      <% } %>

      <form action="/auth/login" method="POST" class="bg-panel border border-white/10 rounded-2xl p-7 md:p-8 shadow-2xl">
        <div class="mb-5">
          <label class="eyebrow block mb-2" for="email">Email</label>
          <input id="email" name="email" type="email" required maxlength="120" autocomplete="email"
                 placeholder="you@example.com"
                 class="w-full bg-ink border border-white/10 rounded-xl px-4 py-3.5 text-sm focus:outline-none focus:border-accent transition-colors" />
        </div>

        <div class="mb-6">
          <label class="eyebrow block mb-2" for="password">Password</label>
          <input id="password" name="password" type="password" required maxlength="72" autocomplete="current-password"
                 placeholder="Enter your password"
                 class="w-full bg-ink border border-white/10 rounded-xl px-4 py-3.5 text-sm focus:outline-none focus:border-accent transition-colors" />
        </div>

        <button type="submit" class="btn-gradient w-full justify-center !py-3.5">
          Sign In <i class="fa-solid fa-arrow-right text-xs"></i>
        </button>

        <p class="text-center text-sm text-white/50 mt-6">
          Don't have an account?
          <a href="/auth/signup" class="text-accent hover:text-white transition-colors">Create one</a>
        </p>
      </form>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>

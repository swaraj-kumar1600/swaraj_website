<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-ink">

  <%- include('../partials/nav') %>

  <section class="pt-40 pb-24 max-w-6xl mx-auto px-6 md:px-10">
    <p class="text-accent text-sm font-semibold tracking-wide">/ Portfolio</p>
    <h1 class="font-display font-extrabold text-5xl mt-4 mb-12">Selected work</h1>

    <div class="grid md:grid-cols-2 gap-6">
      <% projects.forEach(function(project) { %>
        <div class="bg-panel border border-white/10 rounded-xl p-8 hover:border-accent/50 transition-colors">
          <p class="text-xs uppercase tracking-wide text-accent mb-3"><%= project.tag %></p>
          <h3 class="font-display font-semibold text-2xl mb-3"><%= project.title %></h3>
          <p class="text-sm text-white/60"><%= project.summary %></p>
        </div>
      <% }) %>
    </div>
  </section>

  <%- include('../partials/footer') %>

</body>
</html>

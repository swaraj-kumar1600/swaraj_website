<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-ink">

  <%- include('../partials/nav') %>

  <!-- HERO -->
  <section class="relative overflow-hidden bg-ink">
    <div class="max-w-7xl mx-auto px-6 md:px-10 pt-44 pb-16 grid lg:grid-cols-[1.1fr_0.9fr_0.85fr] gap-10 lg:gap-6 items-center">

      <!-- Left: intro copy -->
      <div class="animate-fade-in-up">
        <span class="pill">👋 Hi, I'm</span>

        <h1 class="font-display font-extrabold text-5xl md:text-6xl leading-tight mt-6">
          I'm <%= profile.name %>,<br />
          <span class="text-gradient">an Aspiring<br />Software Developer</span>
        </h1>
        <p class="mt-6 text-white/60 max-w-md">
          CS undergrad at IIIT Sonepat, passionate about Generative AI, data
          science, and building real-world backend systems.
        </p>

        <div class="flex flex-wrap items-center gap-4 mt-9">
          <a href="/portfolio" class="btn-gradient">
            Explore My Work <i class="fa-solid fa-arrow-right text-xs"></i>
          </a>
          <a href="/resume.pdf" target="_blank" class="btn-outline">
            <span class="w-6 h-6 rounded-full bg-white/15 flex items-center justify-center">
              <i class="fa-solid fa-download text-[10px]"></i>
            </span>
            Download Resume
          </a>
        </div>

        <div class="flex gap-10 mt-12">
          <% profile.stats.forEach(function(stat) { %>
            <div>
              <p class="font-display font-extrabold text-3xl text-gradient"><%= stat.value %></p>
              <p class="text-xs text-white/50 mt-1"><%= stat.label %></p>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- Middle: portrait -->
      <div class="flex flex-col items-center gap-5 animate-fade-in-up reveal-delay-1">
        <div class="relative">
          <div class="absolute -inset-2 rounded-full border border-accent/40 glow-ring"></div>
          <div class="w-56 h-56 md:w-64 md:h-64 rounded-full overflow-hidden border-2 border-accent/50 shadow-xl shadow-accent/20 transition-transform duration-300 hover:scale-105">
            <img src="<%= profile.photo %>" alt="<%= profile.fullName %>" class="w-full h-full object-cover object-top" />
          </div>
          <span class="absolute top-2 -right-1 w-3 h-3 rounded-full bg-accent2 animate-float"></span>
        </div>
        <span class="pill text-xs">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          Available for opportunities
        </span>
      </div>

      <!-- Right: About Me card -->
      <div class="animate-fade-in-up reveal-delay-2">
        <div class="bg-panel border border-white/10 rounded-2xl p-7">
          <p class="eyebrow text-accent">About Me</p>
          <span class="block w-10 h-[3px] bg-brand-gradient rounded-full mt-3 mb-4"></span>
          <p class="text-sm text-white/60 leading-relaxed"><%= profile.intro %></p>

          <hr class="border-white/10 my-6" />

          <div class="space-y-4">
            <div class="flex items-start gap-3 text-sm">
              <i class="fa-solid fa-graduation-cap text-accent mt-0.5"></i>
              <div>
                <p class="text-white/80">CS Undergrad</p>
                <p class="text-accent text-xs mt-0.5">IIIT Sonepat</p>
              </div>
            </div>
            <div class="flex items-center gap-3 text-sm text-white/70">
              <i class="fa-solid fa-location-dot text-accent"></i>
              <span><%= profile.location %></span>
            </div>
            <div class="flex items-center gap-3 text-sm text-white/70">
              <i class="fa-solid fa-envelope text-accent"></i>
              <span class="break-all"><%= profile.email %></span>
            </div>
          </div>

          <div class="flex gap-3 mt-6">
            <% profile.social.forEach(function(s) { %>
              <a href="<%= s.href %>" <%= s.href.startsWith('http') ? 'target="_blank" rel="noopener"' : '' %> class="icon-badge" aria-label="<%= s.name %>">
                <i class="<%= s.icon %> text-sm"></i>
              </a>
            <% }) %>
          </div>
        </div>
      </div>

    </div>

    <!-- Decorative wave -->
    <div class="max-w-7xl mx-auto px-6 md:px-10 pb-4 -mt-4">
      <svg viewBox="0 0 1200 90" class="w-full h-16 opacity-70" preserveAspectRatio="none">
        <path d="M0,45 C150,90 300,0 450,45 C600,90 750,0 900,45 C1000,72 1100,20 1200,45"
              fill="none" stroke="url(#waveGrad)" stroke-width="1.5" />
        <defs>
          <linearGradient id="waveGrad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#5b6ef6" />
            <stop offset="100%" stop-color="#9333ea" />
          </linearGradient>
        </defs>
        <circle cx="450" cy="45" r="4" fill="#5b6ef6" />
        <circle cx="900" cy="45" r="4" fill="#9333ea" />
      </svg>
    </div>
  </section>

  <!-- ABOUT / STATS -->
  <section id="about" class="bg-panel py-24">
    <div class="max-w-7xl mx-auto px-6 md:px-10 grid md:grid-cols-2 gap-12 items-center">
      <div class="reveal">
        <p class="text-accent text-sm font-semibold tracking-wide">/ About Me</p>
        <h2 class="font-display font-bold text-4xl md:text-5xl mt-4 leading-tight">
          CS undergrad building<br />across backend & ML
        </h2>
        <p class="mt-6 text-white/60 max-w-lg">
          Currently at IIIT Sonepat, splitting time between backend engineering,
          machine learning fundamentals, and competitive programming.
        </p>
        <div class="flex flex-wrap gap-4 mt-8">
          <a href="/about" class="btn-link">Read Full Bio <i class="fa-solid fa-arrow-right text-[10px]"></i></a>
          <a href="<%= profile.resume %>" target="_blank" class="btn-link">Download Resume <i class="fa-solid fa-download text-[10px]"></i></a>
        </div>
      </div>
      <div class="grid grid-cols-3 gap-6 text-center">
        <% profile.stats.forEach(function(stat, i) { %>
          <div class="reveal reveal-delay-<%= i + 1 %> card-hover bg-ink/40 border border-white/10 rounded-xl py-8 px-3">
            <p class="font-display font-extrabold text-4xl text-accent"><%= stat.value %></p>
            <p class="text-xs text-white/50 mt-2 uppercase tracking-wide"><%= stat.label %></p>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- FEATURED WORK -->
  <section class="py-24">
    <div class="max-w-7xl mx-auto px-6 md:px-10">
      <p class="text-accent text-sm font-semibold tracking-wide">/ Selected Work</p>
      <h2 class="font-display font-bold text-4xl mt-4 mb-12">Recent projects</h2>

      <div class="grid md:grid-cols-3 gap-6">
        <% projects.forEach(function(project, i) { %>
          <div class="reveal reveal-delay-<%= i + 1 %> card-hover bg-panel border border-white/10 rounded-xl p-6">
            <p class="text-xs uppercase tracking-wide text-accent mb-3"><%= project.tag %></p>
            <h3 class="font-display font-semibold text-xl mb-2"><%= project.title %></h3>
            <p class="text-sm text-white/60"><%= project.summary %></p>
          </div>
        <% }) %>
      </div>

      <a href="/portfolio" class="btn-link mt-10">View All Projects <i class="fa-solid fa-arrow-right text-[10px]"></i></a>
    </div>
  </section>

  <%- include('../partials/footer') %>

</body>
</html>
